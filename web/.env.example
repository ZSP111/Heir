# All optional: the defaults point at NEAR testnet + Ethereum Sepolia.
NEXT_PUBLIC_NEAR_NETWORK=testnet
NEXT_PUBLIC_NEAR_RPC_URL=https://rpc.testnet.near.org
NEXT_PUBLIC_HEIR_CONTRACT_ID=heir-vault.testnet
NEXT_PUBLIC_MPC_CONTRACT_ID=v1.signer-prod.testnet
NEXT_PUBLIC_SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Gasless check-ins (server-side only, never NEXT_PUBLIC_). Leave empty to disable.
# A NEAR account that pays the gas, and one of its full-access keys ("ed25519:...").
RELAYER_ACCOUNT_ID=
RELAYER_PRIVATE_KEY=
# Set to "true" to offer gasless check-ins in the UI.
NEXT_PUBLIC_GASLESS=false
